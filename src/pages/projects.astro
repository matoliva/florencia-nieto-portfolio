---

<Layout title='Projects'>
  <div class='title'>
    <h1>Projects</h1>
  </div>
  <section class='projects'>
    {
      projects.map(project => (
        <div class='project'>
          <ProjectCard
            img={project.cover}
            width={700}
            height={700}
            href={project.url}
            linkText={project.title}
            priority={project.id <= 2}
          />
        </div>
      ))
    }
  </section>
</Layout>;

<style>
  .title {
    text-align: center;
    margin-top: 2rem;
  }
  .projects {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(9, auto);
    gap: 1rem;
  }
  .project {
  }
  a {
    color: white;
  }

  @media (max-width: 768px) {
    .projects {
      grid-template-columns: repeat(1, 1fr);
      margin-top: 3rem;
    }
  }
</style>
