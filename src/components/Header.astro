---
import { Image } from 'astro:assets';
---

<header>
  <div class='container'>
    <a class='logo' href='/'>
      <Image
        src='/static/images/florenciaNietoLogo.png'
        alt='Company Logo'
        width={200}
        height={100}
      />
    </a>
    <nav class='nav'>
      <a class='mobile-menu-logo' href='/'>
        <Image
          src='/static/images/florenciaNietoLogo.png'
          alt='Company Logo'
          width={240}
          height={120}
        />
      </a>
      <ul class='nav-list'>
        <li><a class='custom-link' href='/'>About</a></li>
        <li><a class='custom-link' href='/projects'>Projects</a></li>
      </ul>
    </nav>
    <button class='hamburger' type='button' aria-label='Toggle menu' aria-expanded='false'>
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<style>
  header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03);
    z-index: var(--z-sticky);
    padding: 1rem;
  }

  header::before,
  header::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  header::before {
    background-image: url('/static/images/textura-blanca.jpg');
    background-position: center 42%;
    background-repeat: no-repeat;
    background-size: min(100vw, 1789px) auto;
    opacity: 0.76;
  }

  header::after {
    background: linear-gradient(rgba(255, 255, 255, 0.38), rgba(255, 255, 255, 0.62));
  }

  header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .nav-list {
    display: flex;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .nav-list li {
    margin: 0 1rem;
  }

  .mobile-menu-logo {
    display: none;
  }

  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    width: 30px;
    height: 24px;
    position: relative;
  }

  .hamburger span {
    display: block;
    position: absolute;
    height: 2px;
    width: 100%;
    background: var(--text-color);
    border-radius: 2px;
    opacity: 1;
    left: 0;
    transform: rotate(0deg);
    transition: 0.25s ease-in-out;
  }

  .hamburger span:nth-child(1) {
    top: 0px;
  }

  .hamburger span:nth-child(2) {
    top: 10px;
  }

  .hamburger span:nth-child(3) {
    top: 20px;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .nav {
      display: none;
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      background-color: rgba(255, 255, 255, 0.95);
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.82)),
        url('/static/images/textura-blanca.jpg');
      background-position:
        center top,
        center 42%;
      background-repeat:
        no-repeat,
        no-repeat;
      background-size:
        auto,
        cover;
      padding: 4.5rem 1.5rem 2rem;
      overflow-y: auto;
      z-index: var(--z-offcanvas);
    }

    .nav-open {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .mobile-menu-logo {
      display: block;
      width: min(260px, 72vw);
      margin: 0 auto 2.5rem;
    }

    .nav-list {
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }

    .nav-list li {
      margin: 0;
    }

    .nav-list a {
      font-size: 1.15rem;
    }

    .hamburger {
      display: block;
      z-index: calc(var(--z-offcanvas) + 1);
    }

    .hamburger.is-active span {
      color: white;
    }

    .hamburger.is-active span:nth-child(1) {
      top: 10px;
      transform: rotate(135deg);
    }

    .hamburger.is-active span:nth-child(2) {
      opacity: 0;
      left: -60px;
    }

    .hamburger.is-active span:nth-child(3) {
      top: 10px;
      transform: rotate(-135deg);
    }
  }
</style>
<script>
  const hamburger = document.querySelector('.hamburger');
  const nav = document.querySelector('.nav');

  const closeMenu = () => {
    nav?.classList.remove('nav-open');
    hamburger?.classList.remove('is-active');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  const toggleMenu = () => {
    const isOpen = nav?.classList.toggle('nav-open') ?? false;
    hamburger?.classList.toggle('is-active', isOpen);
    hamburger?.setAttribute('aria-expanded', String(isOpen));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  };

  window.addEventListener('resize', closeMenu);

  hamburger?.addEventListener('click', toggleMenu);
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
